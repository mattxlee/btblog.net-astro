---
import 'katex/dist/katex.min.css';
const {
  title = '',
  description = '',
  siteTitle = 'SERENITY',
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} · ${siteTitle}` : siteTitle}</title>
    <meta name="description" content={description ?? siteTitle} />
    <link rel="canonical" href={canonicalURL} />
    <script is:inline>
      // 尽早设置主题，避免首屏闪烁（FOUC）
      (function () {
        try {
          var stored = localStorage.getItem('theme');
        } catch (e) {
          stored = null;
        }
        var dark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <style is:global>
      /* 亮色主题 —— Gruvbox Light (medium) */
      :root {
        --bg: #fbf1c7;
        --fg: #3c3836;
        --muted: #7c6f64;
        --line: #d5c4a1;
        --accent: #076678;
        --code-bg: #f2e5bc;
        --on-accent: #fbf1c7;
        --shadow: rgba(60, 56, 54, 0.18);
        color-scheme: light;
      }

      /* 暗色主题 —— Gruvbox Dark (medium) */
      html[data-theme='dark'] {
        --bg: #282828;
        --fg: #ebdbb2;
        --muted: #a89984;
        --line: #504945;
        --accent: #83a598;
        --code-bg: #1d2021;
        --on-accent: #1d2021;
        --shadow: rgba(0, 0, 0, 0.4);
        color-scheme: dark;
      }

      /* JS 未启用时，跟随系统暗色偏好 */
      @media (prefers-color-scheme: light) {
        :root:not([data-theme]) {
          --bg: #fbf1c7;
          --fg: #3c3836;
          --muted: #7c6f64;
          --line: #d5c4a1;
          --accent: #076678;
          --code-bg: #f2e5bc;
          --on-accent: #fbf1c7;
          --shadow: rgba(60, 56, 54, 0.18);
          color-scheme: light;
        }
      }

      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: "Noto Serif SC", Georgia, "Songti SC", serif;
        line-height: 1.85;
        -webkit-font-smoothing: antialiased;
        transition: background-color 0.25s ease, color 0.25s ease;
      }
      .wrap { max-width: 720px; margin: 0 auto; padding: 0 24px; }
      header.site {
        padding: 32px 0 8px;
        border-bottom: 1px solid var(--line);
        margin-bottom: 40px;
      }
      header.site .wrap { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; }
      .site-title { font-size: 1.6rem; font-weight: 700; margin: 0; }
      .site-title a { color: var(--fg); text-decoration: none; }
      nav.site { display: flex; align-items: center; gap: 20px; margin-left: auto; }
      nav.site a { color: var(--muted); text-decoration: none; font-size: 0.95rem; transition: color 0.2s ease; }
      nav.site a:hover { color: var(--accent); }
      main { min-height: 60vh; }
      footer.site {
        margin-top: 60px;
        padding: 24px 0 40px;
        color: var(--muted);
        font-size: 0.9rem;
        text-align: center;
      }
      a { color: var(--accent); }

      /* 主题切换按钮 */
      button.theme-toggle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 30px;
        height: 30px;
        padding: 0;
        border: 1px solid var(--line);
        border-radius: 50%;
        background: transparent;
        color: var(--muted);
        cursor: pointer;
        transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
      }
      button.theme-toggle:hover { color: var(--accent); border-color: var(--accent); transform: rotate(15deg); }
      button.theme-toggle svg { width: 16px; height: 16px; display: block; }
      /* 亮色模式显示月亮图标，暗色模式显示太阳图标。
         选择器带 button.theme-toggle 前缀，确保优先级不低于上面 button.theme-toggle svg 规则。 */
      button.theme-toggle .icon-light { display: none; }
      html[data-theme='dark'] button.theme-toggle .icon-light { display: block; }
      button.theme-toggle .icon-dark { display: block; }
      html[data-theme='dark'] button.theme-toggle .icon-dark { display: none; }

      /* 代码块：跟随主题切换背景与前景 */
      .prose img { max-width: 100%; height: auto; border-radius: 4px; }
      .prose pre {
        background: var(--code-bg);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 16px;
        overflow-x: auto;
        line-height: 1.6;
      }
      /* 覆盖 Shiki 内联的明暗颜色，使用站点主题变量 */
      .prose pre.astro-code,
      .prose pre.astro-code-themes {
        background-color: var(--code-bg) !important;
        color: var(--fg) !important;
      }
      .prose pre.astro-code .line,
      .prose pre.astro-code span { color: inherit; }
      .prose code { background: var(--code-bg); padding: 0.15em 0.4em; border-radius: 4px; font-size: 0.9em; }
      .prose pre code { background: none; padding: 0; }
      .prose blockquote {
        margin: 0; padding: 0 1.2em;
        border-left: 3px solid var(--line);
        color: var(--muted);
      }
      .prose table { border-collapse: collapse; margin: 1.5em 0; width: 100%; }
      .prose th, .prose td { border: 1px solid var(--line); padding: 0.5em 0.8em; text-align: left; }
      .prose th { background: var(--code-bg); }
      .prose h1, .prose h2, .prose h3, .prose h4 { line-height: 1.4; margin-top: 1.8em; }

      /* KaTeX 公式颜色跟随前景色 */
      .katex { color: var(--fg); }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <h1 class="site-title"><a href="/">SERENITY</a></h1>
        <nav class="site">
          <a href="/">首页</a>
          <a href="/categories/">分类</a>
          <a href="/rss.xml">RSS</a>
          <button
            type="button"
            class="theme-toggle"
            id="theme-toggle"
            aria-label="切换主题"
            title="切换主题"
          >
            <svg class="icon-light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <circle cx="12" cy="12" r="5"></circle>
              <line x1="12" y1="1" x2="12" y2="3"></line>
              <line x1="12" y1="21" x2="12" y2="23"></line>
              <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line>
              <line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
              <line x1="1" y1="12" x2="3" y2="12"></line>
              <line x1="21" y1="12" x2="23" y2="12"></line>
              <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line>
              <line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
            </svg>
            <svg class="icon-dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
          </button>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
          <p>© {new Date().getFullYear()} SERENITY<br /><a href="https://btblog.net">btblog.net</a></p>
      </div>
    </footer>
    <script>
      const toggle = document.getElementById('theme-toggle');
      if (toggle) {
        toggle.addEventListener('click', () => {
          const root = document.documentElement;
          const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
          root.setAttribute('data-theme', next);
          try {
            localStorage.setItem('theme', next);
          } catch (e) {
            /* ignore */
          }
        });
      }
    </script>
  </body>
</html>
