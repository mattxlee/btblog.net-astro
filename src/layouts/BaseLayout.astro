---
const {
  title = '',
  description = '',
  siteTitle = 'SERENITY',
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'http://localhost:4321');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{title ? `${title} · ${siteTitle}` : siteTitle}</title>
    <meta name="description" content={description ?? siteTitle} />
    <link rel="canonical" href={canonicalURL} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.21/dist/katex.min.css"
      integrity="sha384-zh0CIslj+VczvdkcMIjDIEdaW0/yjEGYOMJeS+k0iNcInChOLgXqQbRQ3QW+hQqg"
      crossorigin="anonymous"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+SC:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <style>
      :root {
        --bg: #fffdfa;
        --fg: #2b2b2b;
        --muted: #6b6b6b;
        --line: #e6e2db;
        --accent: #b3541e;
        --code-bg: #f6f4f0;
      }
      * { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; }
      body {
        background: var(--bg);
        color: var(--fg);
        font-family: "Noto Serif SC", Georgia, "Songti SC", serif;
        line-height: 1.85;
        -webkit-font-smoothing: antialiased;
      }
      .wrap { max-width: 720px; margin: 0 auto; padding: 0 24px; }
      header.site {
        padding: 32px 0 8px;
        border-bottom: 1px solid var(--line);
        margin-bottom: 40px;
      }
      header.site .wrap { display: flex; align-items: baseline; gap: 16px; flex-wrap: wrap; }
      .site-title { font-size: 1.6rem; font-weight: 700; margin: 0; }
      .site-title a { color: var(--fg); text-decoration: none; }
      nav.site { display: flex; gap: 20px; margin-left: auto; }
      nav.site a { color: var(--muted); text-decoration: none; font-size: 0.95rem; }
      nav.site a:hover { color: var(--accent); }
      main { min-height: 60vh; }
      footer.site {
        margin-top: 60px;
        padding: 24px 0 40px;
        border-top: 1px solid var(--line);
        color: var(--muted);
        font-size: 0.9rem;
        text-align: center;
      }
      a { color: var(--accent); }
      .prose img { max-width: 100%; height: auto; border-radius: 4px; }
      .prose pre {
        background: var(--code-bg);
        border: 1px solid var(--line);
        border-radius: 6px;
        padding: 16px;
        overflow-x: auto;
        line-height: 1.6;
      }
      .prose code { background: var(--code-bg); padding: 0.15em 0.4em; border-radius: 4px; font-size: 0.9em; }
      .prose pre code { background: none; padding: 0; }
      .prose blockquote {
        margin: 0; padding: 0 1.2em;
        border-left: 3px solid var(--line);
        color: var(--muted);
      }
      .prose table { border-collapse: collapse; margin: 1.5em 0; width: 100%; }
      .prose th, .prose td { border: 1px solid var(--line); padding: 0.5em 0.8em; text-align: left; }
      .prose th { background: var(--code-bg); }
      .prose h1, .prose h2, .prose h3, .prose h4 { line-height: 1.4; margin-top: 1.8em; }
    </style>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <h1 class="site-title"><a href="/">SERENITY</a></h1>
        <nav class="site">
          <a href="/">首页</a>
          <a href="/categories/">分类</a>
          <a href="/tags/">标签</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <p>© {new Date().getFullYear()} SERENITY · 由 WordPress 迁移至 Astro</p>
      </div>
    </footer>
  </body>
</html>
