---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  const tags = [...new Set(posts.flatMap((p) => p.data.tags))].sort();
  return tags.map((t) => ({ params: { tag: t }, props: { tag: t, posts } }));
}

const { tag, posts } = Astro.props;
const tagPosts = posts
  .filter((p) => p.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const tagName = decodeURIComponent(tag);
---

<BaseLayout title={`标签：${tagName}`}>
  <section>
    <h2 style="font-size:1.4rem">标签：{tagName} ({tagPosts.length})</h2>
    <ul style="list-style:none;padding:0">
      {tagPosts.map((p) => (
        <li style="padding:.6rem 0">
          <time style="color:var(--muted);font-size:.85rem">
            {p.data.pubDate.toLocaleDateString('zh-CN')}
          </time>
          <a href={`/posts/${p.id}/`} style="margin-left:.8rem;color:var(--fg);text-decoration:none">
            {p.data.title}
          </a>
        </li>
      ))}
    </ul>
    <p><a href="/tags/">← 返回全部标签</a></p>
  </section>
</BaseLayout>
