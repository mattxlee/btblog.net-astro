---
interface Props {
  currentPage: number;
  totalPages: number;
}

const { currentPage, totalPages } = Astro.props;

const pageUrl = (n: number) => (n === 1 ? '/' : `/page/${n}/`);

// 生成带省略号的分页序列，如：[1, 2, 3, '...', 8, 9]
function pageSequence(current: number, total: number): (number | '...')[] {
  const seq: (number | '...')[] = [];
  const add = (n: number) => {
    const last = seq[seq.length - 1];
    if (typeof last === 'number' && n - last > 1) seq.push('...');
    if (typeof last === 'number' && last === n) return;
    seq.push(n);
  };

  // 始终显示第 1 页
  add(1);
  // 中间：当前页及其相邻
  for (let n = Math.max(2, current - 1); n <= Math.min(total - 1, current + 1); n++) {
    add(n);
  }
  // 始终显示最后一页
  if (total > 1) add(total);

  return seq;
}
---

{
  totalPages > 1 && (
    <nav aria-label="分页" style="display:flex;align-items:center;justify-content:center;gap:8px;margin:36px 0 0;flex-wrap:wrap">
      {currentPage > 1 ? (
        <a href={pageUrl(currentPage - 1)} aria-label="上一页" style="color:var(--accent);text-decoration:none">«</a>
      ) : (
        <span aria-hidden="true" style="color:var(--muted)">«</span>
      )}

      {pageSequence(currentPage, totalPages).map((n) =>
        n === '...' ? (
          <span aria-hidden="true" style="color:var(--muted)">…</span>
        ) : n === currentPage ? (
          <strong
            aria-current="page"
            style="color:var(--bg);background:var(--accent);border-radius:4px;padding:2px 10px;font-weight:600"
          >
            {n}
          </strong>
        ) : (
          <a href={pageUrl(n)} style="color:var(--accent);text-decoration:none;padding:2px 8px">{n}</a>
        ),
      )}

      {currentPage < totalPages ? (
        <a href={pageUrl(currentPage + 1)} aria-label="下一页" style="color:var(--accent);text-decoration:none">»</a>
      ) : (
        <span aria-hidden="true" style="color:var(--muted)">»</span>
      )}
    </nav>
  )
}
